% function [sys,x0,str,ts]=MIMO_Tong_plant(t,x,u,flag)
% switch flag,
% case 0,
%     [sys,x0,str,ts]=mdlInitializeSizes;
% case 1,
%     sys=mdlDerivatives(t,x,u);
% case 3,
%     sys=mdlOutputs(t,x,u);
% case {2, 4, 9 }
%     sys = [];
% otherwise
%     error(['Unhandled flag = ',num2str(flag)]);
% end
% 
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% 
% function [sys,x0,str,ts] = mdlInitializeSizes
% sizes = simsizes;
% sizes.NumContStates = 4;   % q1, dq1, q2, dq2
% sizes.NumDiscStates = 0;
% sizes.NumOutputs = 6;      % q1, dq1, q2, dq2, Fr1, Fr2
% sizes.NumInputs = 4;       % tol1, tol2, Fp1, Fp2
% sizes.DirFeedthrough = 0;
% sizes.NumSampleTimes = 0;
% sys=simsizes(sizes);
% x0 = [0 0 0 0];
% str=[];
% ts=[];
% 
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% 
% function sys = mdlDerivatives(t,x,u)
% r1 = 1;
% r2 = 0.8;
% m1 = 1;
% m2 = 1.5;
% H11 = (m1+m2)*r1^2+m2*r2^2+2*m2*r1*r2*cos(x(3));
% H22 = m2*r2^2;
% H21 = m2*r2^2+m2*r1*r2*cos(x(3));
% H12 = H21;
% 
% H=[H11 H12;H21 H22];
% 
% C12 = m2*r1*sin(x(3));
% 
% C = [-C12*x(4) -C12*(x(2)+x(4));C12*x(1) 0];
% 
% g1 = (m1+m2)*r1*cos(x(3))+m2*r2*cos(x(1)+x(3));
% g2 = m2*r2*cos(x(1)+x(3));
% 
% G = [g1; g2];
% 
% Fr = [15*x(2)+6*sign(x(2));
%       15*x(4)+6*sign(x(4))];
% 
% tol=[u(1) u(2)]';
% 
% S = inv(H)*(tol-C*[x(2);x(4)]-G-Fr);
% 
% sys(1) = x(2);
% sys(2) = S(1);
% sys(3) = x(4);
% sys(4) = S(2);
% 
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% %-------------------------------------------------------------------------%
% 
% function sys = mdlOutputs(t,x,u)
% 
% Fr=[15*x(2)+6*sign(x(2));
%     15*x(4)+6*sign(x(4))];
% 
% sys(1)=x(1);
% sys(2)=x(2);
% sys(3)=x(3);
% sys(4)=x(4);
% sys(5)=Fr(1);
% sys(6)=Fr(2);


%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%


function [sys,x0,str,ts]=MIMO_Tong_plant(t,x,u,flag)
switch flag,
case 0,
    [sys,x0,str,ts]=mdlInitializeSizes;
case 1,
    sys=mdlDerivatives(t,x,u);
case 3,
    sys=mdlOutputs(t,x,u);
case {2, 4, 9 }
    sys = [];
otherwise
    error(['Unhandled flag = ',num2str(flag)]);
end

%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%

function [sys,x0,str,ts] = mdlInitializeSizes
sizes = simsizes;
sizes.NumContStates = 6;   % q1, dq1, q2, dq2, q3, dq3
sizes.NumDiscStates = 0;
sizes.NumOutputs = 9;      % q1, dq1, q2, dq2, q3, dq3, Fr1, Fr2, Fr3
sizes.NumInputs = 6;       % tol1, tol2, tol3, Fp1, Fp2, Fp3
sizes.DirFeedthrough = 0;
sizes.NumSampleTimes = 0;
sys=simsizes(sizes);
x0 = [0 0 0 0 0 0];
str=[];
ts=[];

%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%

function sys = mdlDerivatives(t,x,u)

r1 = 1;
r2 = 0.8;
r3 = 0.6;

m1 = 1;
m2 = 1.5;
m3 = 1.5;

H11 = (m1+m2)*r1^2+m2*r2^2+2*m2*r1*r2*cos(x(3));
H22 = m2*r2^2;
H21 = m2*r2^2+m2*r1*r2*cos(x(3));
H12 = H21;
H22 = m2*r2^2;
H23 = m3 * r2 * r3 * cos(x(5));
H31 = H13;
H32 = H23;
H33 = m3 * r3^2;

H=[H11 H12;H21 H22];

C12 = m2*r1*sin(x(3));

C = [-C12*x(4) -C12*(x(2)+x(4));C12*x(1) 0];

g1 = (m1+m2)*r1*cos(x(3))+m2*r2*cos(x(1)+x(3));
g2 = m2*r2*cos(x(1)+x(3));

G = [g1; g2];

% Mass Matrix
H11 = (m1+m2)*r1^2+m2*r2^2+2*m2*r1*r2*cos(q2);
H12 = m2*r2^2+m2*r1*r2*cos(q2);
H13 = m3 * r1 * r3 * cos(q3);
H21 = H12;
H22 = m2*r2^2;
H23 = m3 * r2 * r3 * cos(q3);
H31 = H13;
H32 = H23;
H33 = m3 * r3^2;

H = [H11, H12, H13;
     H21, H22, H23;
     H31, H32, H33];

% Centrifugal and Coriolis Matrix
C12 = m2*r1*sin(q2);
C13 = -m3 * r1 * r3 * sin(q3) * dq3;
C23 = -m3 * r2 * r3 * sin(q3) * dq3;
C31 = C13;
C32 = C23;
C33 = m3 * r3 * sin(q3) * (dq1 + dq2);

C = [-C12 * dq2, -C12 * (dq1 + dq2), C13;
      C12 * dq1, 0,                  C23;
      C31,       C32,                C33];


% Gravity Matrix
g1 = (m1+m2)*r1*cos(q2)+m2*r2*cos(q1+q2);
g2 = m2*r2*cos(q1+q2);
g3 = m3 * r3 * cos(q1 + q2 + q3);

G = [g1;
     g2;
     g3];


Fr = [15*x(2)+6*sign(x(2));
      15*x(4)+6*sign(x(4));
      15*x(6)+6*sign(x(6))];

tol=[u(1) u(2) u(3)]';

S = inv(H)*(tol-C*[x(2);x(4);x(6)]-G-Fr);

sys(1) = x(2);
sys(2) = S(1);
sys(3) = x(4);
sys(4) = S(2);
sys(5) = x(6);
sys(6) = S(3);

%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%
%-------------------------------------------------------------------------%

function sys = mdlOutputs(t,x,u)

Fr=[15*x(2)+6*sign(x(2));
    15*x(4)+6*sign(x(4));
    15*x(6)+6*sign(x(6))];

sys(1)=x(1);
sys(2)=x(2);
sys(3)=x(3);
sys(4)=x(4);
sys(5)=x(5);
sys(6)=x(6);
sys(7)=Fr(1);
sys(8)=Fr(2);
sys(9)=Fr(3);























